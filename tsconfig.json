{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "typeRoots": ["./types", "element-plus/global", "./node_modules/@types"],
    "target": "ESNext",
    "types": ["node"]
  },
  "paths": {
    "*": ["./types/*"]
  },
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"]
  },
  "include": ["**/*.ts", "types/*.d.ts"],
  "exclude": ["node_modules"]
}
