{
  "name": "who-srhr-dashboard",
  "version": "0.1.0",
  "description": "WHO SRHR Dashboard",
  "repository": {
    "type": "git",
    "url": "git://github.com/lushomo-net/who_srhr"
  },
  "author": "Lucas Bicudo",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"yarn dev:nuxt\" \"yarn dev:prisma\" --names \"nuxt, prisma\" --prefix-colors green,magenta",
    "dev:nuxt": "nuxi dev",
    "dev:prisma": "prisma studio --browser none",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "start": "node .output/server/index.mjs",
    "generate": "nuxi generate",
    "postinstall": "nuxi prepare"
  },
  "prisma": {
    "seed": "node node_modules/.bin/tsx ./prisma/seed.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tailwindcss/typography": "^0.5.15",
    "d3": "^7.9.0",
    "element-plus": "^2.8.7",
    "shave": "^5.0.4",
    "simple-statistics": "^7.8.8",
    "string-mask": "^0.3.0",
    "tabulator-tables": "^6.3.0"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.0",
    "@nuxt/fonts": "^0.10.2",
    "@nuxt/image": "^1.8.1",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.5.1",
    "@prettier/plugin-pug": "^3.2.1",
    "@prisma/client": "^5.22.0",
    "@types/d3": "^7",
    "@types/node": "^22.9.0",
    "@types/tabulator-tables": "^6",
    "@vue/language-plugin-pug": "^2.1.10",
    "@vueuse/nuxt": "^10.7.0",
    "concurrently": "^9.1.2",
    "consola": "^3.2.3",
    "nuxt": "^3.8.2",
    "nuxt-gtag": "3.0.2",
    "nuxt-mapbox": "^1.6.2",
    "nuxt-svgo": "4.0.9",
    "prettier": "^3.5.2",
    "prettier-plugin-classnames": "^0.7.6",
    "prettier-plugin-merge": "^0.7.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^5.22.0",
    "pug": "^3.0.3",
    "sass": "^1.69.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.10",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "pinia": "^2.1.6"
  },
  "packageManager": "yarn@4.5.1+sha256.dc2e45a77f87a9c2a76708d098ab54ca0cfdd5ec2cf7d9e3c1f24bf786a2383c"
