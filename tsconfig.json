{
  "extends": "./.nuxt/tsconfig.json",
  "module": "ESNext",
  "moduleResolution": "node",
  "compilerOptions": {
    "typeRoots": ["./types", "element-plus/global", "./node_modules/@types"],
    "target": "ESNext"
  },
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"]
  },
  "includes": ["types/*.d.ts"]
}
