generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite3"
}

model Indicator {
  id             String      @id @map("kpi_id")
  name           String      @unique @map("kpi_name")
  fullName       String      @map("kpi_full_name")
  subheading     String?     @map("kpi_subheading")
  type           String      @map("kpi_data_type")
  hasTarget      Boolean     @default(false) @map("has_target")
  mask           String?     @map("mask")
  isLaw          Boolean     @default(false) @map("is_law")
  translateValue String?     @map("translate_value")
  displayValue   String?     @map("display_value")
  domainId       Int         @map("kpi_domain_id")
  domain         Domain      @relation(fields: [domainId], references: [id])
  subgroups      Subgroup[]
  dataPoints     DataPoint[]
  tableView      Boolean     @default(false) @map("table_view")
  chartView      Boolean     @default(false) @map("chart_view")
  mapView        Boolean     @default(false) @map("map_view")
  mapType        String?     @map("map_type")

  @@map("indicators")
}

model Domain {
  id         Int         @id @map("domain_id")
  name       String      @unique @map("domain_name")
  indicators Indicator[]

  @@map("domains")
}

model Subgroup {
  id         Int         @id @default(autoincrement())
  name       String      @unique @map("kpi_subgroup")
  fullName   String      @map("kpi_subgroup_full")
  indicators Indicator[]
  dataPoints DataPoint[]
}

model DataPoint {
  id                Int       @id @default(autoincrement())
  indicator         Indicator @relation(fields: [indicatorId], references: [id])
  indicatorId       String
  subgroup          Subgroup? @relation(fields: [subgroupId], references: [id])
  subgroupId        Int?
  country           Country   @relation(fields: [countryId], references: [id])
  countryId         Int
  currentYearSource String?   @map("current_year_source")
  currentYear       Int?      @map("current_year")
  source            String?   @map("source")
  originalValue     String?   @map("original_value")
  parsedValue       String?   @map("value_to_use")
  value             String?   @map("value")
  change            String?   @map("change")
  trend             String?   @map("trend_color")

  @@index([indicatorId])
  @@index([countryId])
  @@index([indicatorId, countryId])
  @@map("data_points")
}

model Country {
  id         Int         @id @default(autoincrement())
  name       String      @unique @map("country")
  code       String      @unique @map("country_code")
  dataPoints DataPoint[]
  incomeType String?   @map("country_income_type")
  region     String?   @map("who_region")

  @@map("countries")
}
