{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ESNext",
    "typeRoots": ["element-plus/global", "./node_modules/@types"],
    "forceConsistentCasingInFileNames": true
  },
  "paths": {
    "*": ["./types/*"]
  },
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"]
  },
  "includes": ["types/*.d.ts", "types/filters.d.ts"]
}
